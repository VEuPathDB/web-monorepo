{
  "extends": "nx/presets/npm.json",
  "workspaceLayout": {
    "appsDir": "packages/sites",
    "libsDir": "packages/libs"
  },
  "namedInputs": {
    "srcFiles": ["!{projectRoot}/{lib,dist}/**/*"]
  },
  "targetDefaults": {
    "build-npm-modules": {
      "cache": true,
      "dependsOn": ["^build-npm-modules"],
      "inputs": ["srcFiles", "^srcFiles"],
      "outputs": ["{projectRoot}/lib"]
    },
    "start": {
      "dependsOn": ["^build-npm-modules"]
    },
    "compile:check": {
      "cache": true,
      "dependsOn": ["^build-npm-modules"],
      "inputs": ["srcFiles", "^srcFiles"]
    },
    "bundle:dev": {
      "cache": true,
      "dependsOn": ["^build-npm-modules"],
      "inputs": ["srcFiles", "^srcFiles"],
      "outputs": ["{projectRoot}/dist"]
    },
    "bundle:npm": {
      "cache": true,
      "dependsOn": ["^build-npm-modules"],
      "inputs": ["srcFiles", "^srcFiles"],
      "outputs": ["{projectRoot}/dist"]
    },
    "bundle:analyze": {
      "dependsOn": ["^build-npm-modules"]
    },
    "storybook": {
      "dependsOn": ["^build-npm-modules"]
    }
  },
  "affected": {
    "defaultBase": "main"
  },
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "analytics": false
}
