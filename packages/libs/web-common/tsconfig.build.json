{
  "extends": "./tsconfig.json",
  "include": [
    "src"
  ],
  "exclude": [
    "**/__test__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "src/setupTests.ts"
  ],
  "compilerOptions": {
    "noEmit": false,
    "outDir": "lib",
    "target": "ES2015",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  }
}

